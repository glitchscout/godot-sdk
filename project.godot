; Development and test project for the Glitchscout Godot SDK. The shipped addon is addons/glitchscout/.

config_version=5

[application]

config/name="Glitchscout SDK"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Glitchscout="*res://addons/glitchscout/glitchscout.gd"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[gdunit4]

; GdUnit4 times tests in game time. Tests run at --fixed-fps 60 headless, far faster than real time, so its
; 5-minute default expires in about a second; the CI job timeout bounds wall time instead.
settings/test/test_timeout_seconds=86400000
